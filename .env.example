# ──────────────────────────────────────────────
# Database
# ──────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://sidequest:sidequest@localhost:5432/sidequest

# ──────────────────────────────────────────────
# Authentication (NextAuth.js)
# ──────────────────────────────────────────────
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=your-secret-here
NEXTAUTH_URL=http://localhost:3000

# Google OAuth (optional — email login works without this)
# Get from: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ──────────────────────────────────��───────────
# Google Cloud / Vertex AI
# ──────────────────────────────────────────────
GOOGLE_API_KEY=your-google-api-key-here
GOOGLE_CLOUD_PROJECT=your-project-id-here
GOOGLE_CLOUD_LOCATION=us-central1

# ──────────────────────────────────────────────
# Foursquare Places API (free tier)
# Get from: https://foursquare.com/developers
# ──────────────────────────────────────────────
FOURSQUARE_API_KEY=

# ──────────────────────────────────────────────
# Backend
# ──────────────────────────────────────────────
BACKEND_PORT=8000
BACKEND_HOST=0.0.0.0

# ──────────────────────────────────────────────
# Frontend
# ──────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000

# ──────────────────────────────────────────────
# Optional: LangSmith tracing
# ──────────────────────────────────────────────
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=sidequest-dev
LANGSMITH_TRACING=false

# ──────────────────────────────────────────────
# Optional: Reddit enrichment
# ──────────────────────────────────────────────
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
ENABLE_REDDIT_ENRICHMENT=false

# ──────────────────────────────────────────────
# Agent Logging
# ──────────────────────────────────────────────
AGENT_LOG_LEVEL=INFO
AGENT_LOG_DIR=backend/logs
AGENT_LOG_FILE_ENABLED=true
AGENT_LOG_CONSOLE_ENABLED=true
AGENT_LOG_FORMAT=json
AGENT_LOG_SANITIZE=true
AGENT_LOG_MAX_SIZE_MB=100
AGENT_LOG_BUFFER_SIZE=10
AGENT_LOG_FLUSH_INTERVAL=5
AGENT_LOG_RETENTION_DAYS=30

# ──────────────────────────────────────────────
# Payments (Phase 4)
# ──────────────────────────────────────────────
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
